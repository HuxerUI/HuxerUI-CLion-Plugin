<idea-plugin>
    <id>org.huxerui</id>
    <name>HuxerUI</name>
    <vendor url="https://github.com/HuxerUI">HuxerUI</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.clion</depends>
    <depends>com.intellij.cmake</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="org.huxerui.clion.settings.HuxerUISettings"/>
        <projectService serviceImplementation="org.huxerui.clion.project.HuxerUIProjectService"/>
        <directoryProjectGenerator implementation="org.huxerui.clion.project.HuxerUIAppProjectGenerator"/>
        <directoryProjectGenerator implementation="org.huxerui.clion.project.HuxerUIModuleProjectGenerator"/>
        <applicationConfigurable
                id="org.huxerui.clion.settings"
                parentId="tools"
                displayName="HuxerUI"
                instance="org.huxerui.clion.settings.HuxerUIConfigurable"/>
        <gotoDeclarationHandler
                implementation="org.huxerui.clion.resources.HuxerUIResourceGotoHandler"
                order="first"/>
        <completion.contributor language="C++"
                implementationClass="org.huxerui.clion.resources.HuxerUIResourceCompletionContributor"/>
        <completion.contributor language="ObjectiveC"
                implementationClass="org.huxerui.clion.resources.HuxerUIResourceCompletionContributor"/>
        <configurationType implementation="org.huxerui.clion.run.HuxerUIConfigurationType"/>
        <postStartupActivity implementation="org.huxerui.clion.project.HuxerUIProjectStartupActivity"/>
        <notificationGroup id="HuxerUI" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="HuxerUI.InstallSdk"
                class="org.huxerui.clion.sdk.InstallSdkAction"
                text="Install HuxerUI SDK..."
                description="Download and install the latest HuxerUI SDK from GitHub Releases"/>
        <group id="HuxerUI.Tools" text="HuxerUI" popup="true">
            <reference ref="HuxerUI.InstallSdk"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <group id="HuxerUI.Build" class="org.huxerui.clion.build.HuxerUIBuildActionGroup"
                text="HuxerUI" popup="true">
            <add-to-group group-id="BuildMenu" anchor="last"/>
            <add-to-group group-id="RunToolbarMainActionGroup" anchor="after"
                    relative-to-action="RunToolbarTopLevelExecutorActionGroup"/>
            <add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="RunnerActions"/>
        </group>
    </actions>
</idea-plugin>
